<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">
    <t t-name="sd_apps.website_card">
<!--            <div class="border m-2" t-esc="box.name"></div>-->
        <div class="client_card row border shadow rounded m-1 m-md-3 p-0 border-dark-subtle" t-attf-class="client_card_border_color_{{props.card.color}}"
             t-on-click="props.hasOwnProperty('onClick') ? ()=>props.onClick( 'down', props.card, props.this ) : ''">
            <div t-attf-class="p-0 client_card_color client_card_color_{{props.card.color}}"> </div>
            <div class="col p-0 ms-2 ">
                <div class="row mx-0 client_card_top">
<!--                    <div class="col-5 p-2 client_card_image"><img t-if="props.card.image" class="rounded" t-att-src="'data:image/png;base64,' + props.card.image"/></div>-->
                    <div class="col-5 p-2 client_card_image">
<!--                        <img t-if="props.card.icon" t-attf-src="props.card.icon"/>-->
                        <img t-if="props.card.icon == 'icon'" class="rounded"
                             t-attf-src="/web/image?model=ir.ui.menu&amp;id={{props.card.id}}&amp;field=web_icon_data"/>
                        <img t-if="props.card.icon == 'base'" class="rounded"
                             t-attf-src="/base/static/description/icon.png"/>
                        <img t-if="props.card.icon == 'image'" class="rounded"
                             t-attf-src="/web/image?model=sd_apps.settings&amp;id={{props.card.id}}&amp;field=image"/>
                    </div>
                    <div class="col "></div>
                </div>
                <div class="h5 text-primary text-center client_card_title font-weight-bold px-1 "
                     t-esc="props.card.name">
                </div>
            </div>
        </div>

    </t>
</templates>
