<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="my_snippets" inherit_id="website.snippets" name="My Snippets">
        <xpath expr="//t[@id='default_snippets']" position="after">
    <!--                <div class="o_panel_header">SD Structure</div>-->
                <snippets id="sd_apps_snippets_elements" string="SD Apps">
                        <t t-snippet="sd_apps.sd_apps_snippet" t-thumbnail="/sd_apps/static/src/img/snippets_thumbs/s_banner.svg">
                            <keywords>web, apps, applications</keywords>
                        </t>
                    </snippets>
        </xpath>
    </template>

</odoo>
